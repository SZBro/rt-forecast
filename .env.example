ANTHROPIC_API_KEY=
DISCORD_WEBHOOK_URL=

# Database file (default: data/rt.db).
# Keep it OUTSIDE OneDrive/Dropbox: syncing a live SQLite file can lock or
# corrupt it. On Windows e.g. C:/rt-data/rt.db; on the server /var/lib/rt-forecast/rt.db.
RT_DB_PATH=data/rt.db

# Gzipped raw API responses (default: data/raw). Same rule: not a synced folder.
RT_RAW_DIR=data/raw
