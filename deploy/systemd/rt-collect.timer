# rt-forecast: run rt-collect.service every 15 minutes, on the quarter hour (UTC).
# Install: /etc/systemd/system/rt-collect.timer, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now rt-collect.timer
[Unit]
Description=rt-forecast: collect Kalshi snapshots every 15 minutes

[Timer]
OnCalendar=*:00/15
# Run a missed pass right after boot (e.g. after the 11:00 UTC update reboot).
Persistent=true
AccuracySec=5s

[Install]
WantedBy=timers.target
